# Copy to server/.env. Never commit real keys.
YANDEX_RASP_API_KEY=
# Optional. Relative paths are resolved against server/, not the current terminal.
TRAINSTER_DATABASE=data/trainster.sqlite3
TRAINSTER_SESSION_DAYS=30
TRAINSTER_STATION_CACHE_HOURS=168
TRAINSTER_ANDROID_PACKAGE=ru.trainster.app
# Optional inferred railway tracing through the real OpenStreetMap rail network.
TRAINSTER_OVERPASS_URL=https://overpass-api.de/api/interpreter
TRAINSTER_RAIL_CACHE_HOURS=168
# TRAINSTER_RAIL_CACHE_DIR=C:/path/to/rail-cache

# Optional self-hosted Valhalla; default is a best-effort public demo (no key).
TRAINSTER_WALK_ROUTING_URL=https://valhalla1.openstreetmap.de/route

# Optional compatible/self-hosted Photon endpoint; no API key is needed.
TRAINSTER_PLACE_SEARCH_URL=https://photon.komoot.io/api/
